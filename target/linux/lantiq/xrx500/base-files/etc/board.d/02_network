#!/bin/sh

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

xrx500_setup_interfaces() {
	local board="$1"

	case "$board" in
	tplink,archer-ax50-v1)
		ucidef_set_interfaces_lan_wan "eth1 eth2 eth3 eth4" "eth0"
		;;
	*)
		ucidef_set_interfaces_lan_wan "eth1" "eth0"
		;;
	esac
}

xrx500_setup_macs() {
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	tplink,archer-ax50-v1)
		label_mac=$(grep -o 'ethaddr=[0-9a-fA-F:]*' /proc/cmdline 2>/dev/null | cut -d= -f2)
		[ -z "$label_mac" ] && label_mac=$(mtd_get_mac_ascii "ubootconfigA" "ethaddr")
		[ -z "$label_mac" ] && label_mac=$(mtd_get_mac_ascii "ubootconfigB" "ethaddr")

		if [ -n "$label_mac" ]; then
			lan_mac="$label_mac"
			wan_mac=$(macaddr_add "$label_mac" 1)
		fi
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	[ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
xrx500_setup_interfaces "$board"
xrx500_setup_macs "$board"
board_config_flush

exit 0
