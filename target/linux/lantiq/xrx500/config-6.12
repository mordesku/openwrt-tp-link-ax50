# Explicitly unset other Lantiq SoC types — parent lantiq/config-6.12 sets SOC_XWAY=y
# which wins the Kconfig choice() by default. We must explicitly unset it here.
# CONFIG_SOC_XWAY is not set
# CONFIG_SOC_FALCON is not set
CONFIG_SOC_GRX500=y
CONFIG_EVA=y
CONFIG_MIPS_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_MIPS_CMDLINE_FROM_DTB is not set
# CONFIG_MIPS_CMDLINE_DTB_EXTEND is not set
CONFIG_MIPS_CM=y
CONFIG_MIPS_CPC=y
CONFIG_MIPS_CPS=y
CONFIG_MIPS_GIC=y
CONFIG_CLKSRC_MIPS_GIC=y
CONFIG_MIPS_MT=y
CONFIG_MIPS_MT_SMP=y
CONFIG_MIPS_PERF_SHARED_TC_COUNTERS=y
CONFIG_NR_CPUS=4
CONFIG_MIPS_NR_CPU_NR_MAP=4
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
# CONFIG_PCIE_LANTIQ is not set
CONFIG_PCIE_GRX500=y
# CONFIG_PCI_LANTIQ is not set
CONFIG_MIPS_MT_FPAFF=y
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_NET_FLOW_LIMIT=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_XWAY=y
CONFIG_MTD_NAND_ECC_SW_BCH=y
CONFIG_BCH=y
CONFIG_SERIAL_LANTIQ=y
CONFIG_SERIAL_LANTIQ_CONSOLE=y
CONFIG_DEVTMPFS=y
# /dev/mem for RAM-image diagnostics: BusyBox devmem reads of PCIe BAR0 MMIO
# (WAV654 env registers, SHRAM). Disabled by OpenWrt default (KERNEL_DEVMEM=n).
CONFIG_DEVMEM=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BEB_LIMIT=20
CONFIG_MTD_UBI_BLOCK=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_UBIFS_FS=y
CONFIG_GRX500_DATAPATH=m
CONFIG_MDIO_GRX500_GSWIP=m
CONFIG_GPIO_XRX500=y
CONFIG_GPIOLIB_IRQCHIP=y
# New symbols that appeared after switching from SOC_XWAY to SOC_GRX500:
CONFIG_CLOCKSOURCE_WATCHDOG_MAX_SKEW_US=125
# CONFIG_MIPS_CPS_NS16550_BOOL is not set
CONFIG_GRX500_GPTC_TIMER=y
CONFIG_USB_LEDS_TRIGGER_USBPORT=y
# Wireless & CFG80211 for WAV654 / Wave600 Wi-Fi 6
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
# CONFIG_CFG80211_WEXT is not set
# CONFIG_NL80211_TESTMODE is not set
CONFIG_WLAN=y
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_VIRT_WIFI is not set
# CONFIG_ASYMMETRIC_KEY_TYPE is not set
# CONFIG_SYSTEM_DATA_VERIFICATION is not set
# CONFIG_CFG80211_DEVELOPER_WARNINGS is not set
# CONFIG_CFG80211_CERTIFICATION_ONUS is not set
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
CONFIG_CFG80211_EXTRA_REGDB_KEYDIR=""
# CONFIG_CFG80211_REG_CELLULAR_HINTS is not set
CONFIG_CFG80211_REG_RELAX_NO_IR=y
# CONFIG_CFG80211_DEFAULT_PS is not set
# CONFIG_CFG80211_DEBUGFS is not set
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# CONFIG_CFG80211_WEXT_EXPORT is not set
# CONFIG_CFG80211_KUNIT_TEST is not set
# CONFIG_LIB80211 is not set
# CONFIG_MAC80211 is not set
CONFIG_WAVE600_WIFI=m
