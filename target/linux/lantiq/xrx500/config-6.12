# Explicitly unset other Lantiq SoC types — parent lantiq/config-6.12 sets SOC_XWAY=y
# which wins the Kconfig choice() by default. We must explicitly unset it here.
# CONFIG_SOC_XWAY is not set
# CONFIG_SOC_FALCON is not set
CONFIG_SOC_GRX500=y
CONFIG_EVA=y
CONFIG_MIPS_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_MIPS_CMDLINE_FROM_DTB is not set
# CONFIG_MIPS_CMDLINE_DTB_EXTEND is not set
CONFIG_MIPS_CM=y
CONFIG_MIPS_CPC=y
CONFIG_MIPS_CPS=y
CONFIG_MIPS_GIC=y
CONFIG_CLKSRC_MIPS_GIC=y
CONFIG_MIPS_MT=y
CONFIG_MIPS_MT_SMP=y
CONFIG_MIPS_PERF_SHARED_TC_COUNTERS=y
CONFIG_NR_CPUS=4
CONFIG_MIPS_NR_CPU_NR_MAP=4
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
# CONFIG_PCIE_LANTIQ is not set
CONFIG_PCIE_GRX500=y
# CONFIG_PCI_LANTIQ is not set
CONFIG_MIPS_MT_FPAFF=y
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_NET_FLOW_LIMIT=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_XWAY=y
CONFIG_MTD_NAND_ECC_SW_BCH=y
CONFIG_BCH=y
CONFIG_SERIAL_LANTIQ=y
CONFIG_SERIAL_LANTIQ_CONSOLE=y
CONFIG_DEVTMPFS=y
# /dev/mem for RAM-image diagnostics: BusyBox devmem reads of PCIe BAR0 MMIO
# (WAV654 env registers, SHRAM). Disabled by OpenWrt default (KERNEL_DEVMEM=n).
CONFIG_DEVMEM=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BEB_LIMIT=20
CONFIG_MTD_UBI_BLOCK=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_UBIFS_FS=y
CONFIG_GRX500_DATAPATH=m
CONFIG_MDIO_GRX500_GSWIP=m
CONFIG_GPIO_XRX500=y
CONFIG_GPIOLIB_IRQCHIP=y
# New symbols that appeared after switching from SOC_XWAY to SOC_GRX500:
CONFIG_CLOCKSOURCE_WATCHDOG_MAX_SKEW_US=125
# CONFIG_MIPS_CPS_NS16550_BOOL is not set
CONFIG_GRX500_GPTC_TIMER=y
CONFIG_USB_LEDS_TRIGGER_USBPORT=y
