From: Thomas Nixon <tom@tomn.co.uk>
Date: Sun, 26 Mar 2023 11:08:49 +0100
Subject: [PATCH] mtd: rawnand: xway: bound polling loops and don't yield while holding spinlock

The nand driver normally yields while waiting for the device to become ready;
this is normally fine, but xway_nand holds the ebu_lock spinlock, and
this can cause lockups if other threads which use ebu_lock are
interleaved. Fix this by waiting instead of polling in dev_ready.

Additionally, bound all loops in xway_cmd_ctrl() with timeouts and
rate-limited error reporting, so an unasserted EBU_NAND_WAIT (WR_C or RD)
cannot hang the CPU with interrupts disabled under ebu_lock.

Signed-off-by: Thomas Nixon <tom@tomn.co.uk>
---
 drivers/mtd/nand/raw/xway_nand.c | 47 +++++++++++++++++++++++++++++++++++++++--
 1 file changed, 45 insertions(+), 2 deletions(-)

--- a/drivers/mtd/nand/raw/xway_nand.c
+++ b/drivers/mtd/nand/raw/xway_nand.c
@@ -8,6 +8,7 @@
 #include <linux/mtd/rawnand.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/delay.h>
 
 #include <lantiq_soc.h>
 
@@ -137,6 +138,7 @@
 static void xway_cmd_ctrl(struct nand_chip *chip, int cmd, unsigned int ctrl)
 {
 	struct mtd_info *mtd = nand_to_mtd(chip);
+	int timeout;
 
 	if (req_mask) {
 		if (cmd != NAND_CMD_STATUS)
@@ -151,8 +153,15 @@
 	else if (ctrl & NAND_ALE)
 		xway_writeb(mtd, NAND_WRITE_ADDR, cmd);
 
-	while ((ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_WR_C) == 0)
-		;
+	timeout = 100000; /* 100ms max wait */
+	while ((ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_WR_C) == 0) {
+		if (--timeout <= 0) {
+			pr_err_ratelimited("xway_nand: cmd_ctrl WR_C timeout (cmd=0x%02x ctrl=0x%02x EBU_NAND_WAIT=0x%08x)\n",
+					   cmd, ctrl, ltq_ebu_r32(EBU_NAND_WAIT));
+			break;
+		}
+		udelay(1);
+	}
 
 	if (req_mask) {
 	       /*
@@ -168,14 +177,36 @@
 		}
 
 		/* wait until command is processed */
-		while ((ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_RD) == 0)
-			;
+		timeout = 100000;
+		while ((ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_RD) == 0) {
+			if (--timeout <= 0) {
+				pr_err_ratelimited("xway_nand: cmd_ctrl RD timeout (cmd=0x%02x EBU_NAND_WAIT=0x%08x)\n",
+						   cmd, ltq_ebu_r32(EBU_NAND_WAIT));
+				break;
+			}
+			udelay(1);
+		}
 	}
 }
 
 static int xway_dev_ready(struct nand_chip *chip)
 {
-	return ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_RD;
+	int timeout = 100000; /* 100ms max wait */
+
+	/*
+	 * wait until ready, as otherwise the driver will yield in nand_wait or
+	 * nand_wait_ready, which is a bad idea when we're holding ebu_lock.
+	 * Bound the loop so a bus or controller stall cannot lock the CPU.
+	 */
+	while ((ltq_ebu_r32(EBU_NAND_WAIT) & NAND_WAIT_RD) == 0) {
+		if (--timeout <= 0) {
+			pr_err_ratelimited("xway_nand: dev_ready timeout (EBU_NAND_WAIT=0x%08x)\n",
+					   ltq_ebu_r32(EBU_NAND_WAIT));
+			return 1;
+		}
+		udelay(1);
+	}
+	return 1;
 }
 
 static unsigned char xway_read_byte(struct nand_chip *chip)
