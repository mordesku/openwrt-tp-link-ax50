--- a/drivers/net/mdio/Kconfig
+++ b/drivers/net/mdio/Kconfig
@@ -1,3 +1,10 @@
 # SPDX-License-Identifier: GPL-2.0-only
+config MDIO_GRX500_GSWIP
+	tristate "GRX500 GSWIP MDIO controller"
+	depends on OF_MDIO && LANTIQ
+	help
+	  Expose the GSWIP 3.0 MDIO controllers on GRX500. This does not
+	  initialize GPHY firmware, the switch datapath, or Ethernet MACs.
+
 #
 # MDIO Layer Configuration
 #
--- a/drivers/net/mdio/Makefile
+++ b/drivers/net/mdio/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_MDIO_GRX500_GSWIP)		+= mdio-grx500.o
 obj-$(CONFIG_MDIO_DEVICE)		+= mdio_device.o
 obj-$(CONFIG_MDIO_DEVRES)		+= mdio_devres.o
