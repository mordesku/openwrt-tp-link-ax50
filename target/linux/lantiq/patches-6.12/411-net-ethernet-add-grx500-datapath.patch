--- a/drivers/net/ethernet/Kconfig
+++ b/drivers/net/ethernet/Kconfig
@@ -1,3 +1,11 @@
 # SPDX-License-Identifier: GPL-2.0-only
+config GRX500_DATAPATH
+	tristate "GRX500 CBM/TMU packet path (bring-up)"
+	depends on LANTIQ && OF
+	help
+	  Provide the AX50 LAN1 netdevice through the GRX500 CBM/TMU packet
+	  path, with DMA, NAPI receive and read-only bring-up diagnostics.
+	  Other Ethernet ports are not exposed as netdevices yet.
+
