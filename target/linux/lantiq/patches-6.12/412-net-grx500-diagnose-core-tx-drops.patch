From: AX50 bring-up <ax50@localhost>
Subject: [PATCH] net: diagnose AX50 core TX drops before driver submission

Hypothesis: the unaccounted LAN1 tx_dropped increments originate in the
network core before ndo_start_xmit, possibly while preparing ARP packets.
Record validation stage and errno, noqueue/direct failures, and the caller
of every core TX-drop increment. Only CONFIG_GRX500_DATAPATH builds and
lan1 emit messages, with rate limits. Packet ownership and return values
are unchanged. This is temporary diagnostic instrumentation, not a fix.

--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -3744,18 +3744,39 @@
 }
 EXPORT_SYMBOL(skb_csum_hwoffload_help);
 
+/* AX50 experiment: driver failure counters stay zero while tx_dropped rises.
+ * Log only failures, retaining metadata before helpers can consume the skb.
+ * The common core counter below also identifies callers outside this file.
+ */
+static void ax50_tx_core_drop(struct net_device *dev, const char *stage,
+                             u16 protocol, unsigned int len, int error,
+                             netdev_features_t features)
+{
+	if (IS_ENABLED(CONFIG_GRX500_DATAPATH) && !strcmp(dev->name, "lan1"))
+		pr_warn_ratelimited("AX50 TX core stage=%s proto=%04x len=%u error=%d features=%016llx up=%u running=%u carrier=%u\n",
+			stage, protocol, len, error, (unsigned long long)features,
+			!!(dev->flags & IFF_UP), netif_running(dev),
+			netif_carrier_ok(dev));
+}
+
 static struct sk_buff *validate_xmit_skb(struct sk_buff *skb, struct net_device *dev, bool *again)
 {
-	netdev_features_t features;
+	netdev_features_t features = 0;
+	const char *stage = "unreadable_frags";
+	unsigned int original_len = skb->len;
+	u16 original_protocol = ntohs(skb->protocol);
+	int error = 0;
 
 	if (!skb_frags_readable(skb))
 		goto out_kfree_skb;
 
 	features = netif_skb_features(skb);
+	stage = "vlan";
 	skb = validate_xmit_vlan(skb, features);
 	if (unlikely(!skb))
 		goto out_null;
 
+	stage = "socket_validate";
 	skb = sk_validate_xmit_skb(skb, dev);
 	if (unlikely(!skb))
 		goto out_null;
@@ -3765,15 +3786,21 @@
 
 		segs = skb_gso_segment(skb, features);
 		if (IS_ERR(segs)) {
+			stage = "gso_segment";
+			error = PTR_ERR(segs);
 			goto out_kfree_skb;
 		} else if (segs) {
 			consume_skb(skb);
 			skb = segs;
 		}
 	} else {
-		if (skb_needs_linearize(skb, features) &&
-		    __skb_linearize(skb))
-			goto out_kfree_skb;
+		if (skb_needs_linearize(skb, features)) {
+			error = __skb_linearize(skb);
+			if (error) {
+				stage = "linearize";
+				goto out_kfree_skb;
+			}
+		}
 
 		/* If packet is not checksummed and device does not
 		 * support checksumming for this protocol, complete
@@ -3786,8 +3813,11 @@
 			else
 				skb_set_transport_header(skb,
 							 skb_checksum_start_offset(skb));
-			if (skb_csum_hwoffload_help(skb, features))
+			error = skb_csum_hwoffload_help(skb, features);
+			if (error) {
+				stage = "checksum";
 				goto out_kfree_skb;
+			}
 		}
 	}
 
@@ -3798,6 +3828,8 @@
 out_kfree_skb:
 	kfree_skb(skb);
 out_null:
+	ax50_tx_core_drop(dev, stage, original_protocol, original_len,
+			  error, features);
 	dev_core_stats_tx_dropped_inc(dev);
 	return NULL;
 }
@@ -4440,6 +4472,7 @@
 	struct Qdisc *q;
 	int rc = -ENOMEM;
 	bool again = false;
+	const char *drop_stage = "device_down";
 
 	skb_reset_mac_header(skb);
 	skb_assert_len(skb);
@@ -4523,7 +4556,9 @@
 
 			HARD_TX_LOCK(dev, txq, cpu);
 
+			drop_stage = "noqueue_stopped";
 			if (!netif_xmit_stopped(txq)) {
+				drop_stage = "noqueue_driver_busy";
 				dev_xmit_recursion_inc();
 				skb = dev_hard_start_xmit(skb, dev, txq, &rc);
 				dev_xmit_recursion_dec();
@@ -4540,11 +4575,14 @@
 			 * unfortunately
 			 */
 recursion_alert:
+			drop_stage = "noqueue_recursion";
 			net_crit_ratelimited("Dead loop on virtual device %s, fix it urgently!\n",
 					     dev->name);
 		}
 	}
 
+	ax50_tx_core_drop(dev, drop_stage, skb ? ntohs(skb->protocol) : 0,
+			  skb ? skb->len : 0, rc, dev->features);
 	rc = -ENETDOWN;
 	rcu_read_unlock_bh();
 
@@ -4564,11 +4602,15 @@
 	struct netdev_queue *txq;
 	int ret = NETDEV_TX_BUSY;
 	bool again = false;
+	const char *drop_stage = "direct_not_ready";
+	u16 original_protocol = ntohs(skb->protocol);
+	unsigned int original_len = skb->len;
 
 	if (unlikely(!netif_running(dev) ||
 		     !netif_carrier_ok(dev)))
 		goto drop;
 
+	drop_stage = "direct_validate_list";
 	skb = validate_xmit_skb_list(skb, dev, &again);
 	if (skb != orig_skb)
 		goto drop;
@@ -4588,6 +4630,8 @@
 	local_bh_enable();
 	return ret;
 drop:
+	ax50_tx_core_drop(dev, drop_stage, original_protocol, original_len,
+			  ret, dev->features);
 	dev_core_stats_tx_dropped_inc(dev);
 	kfree_skb_list(skb);
 	return NET_XMIT_DROP;
@@ -11012,6 +11056,11 @@
 
 	field = (unsigned long __percpu *)((void __percpu *)p + offset);
 	this_cpu_inc(*field);
+	if (IS_ENABLED(CONFIG_GRX500_DATAPATH) &&
+	    offset == offsetof(struct net_device_core_stats, tx_dropped) &&
+	    !strcmp(dev->name, "lan1"))
+		pr_warn_ratelimited("AX50 TX core counter=tx_dropped caller=%pS\n",
+			(void *)_RET_IP_);
 }
 EXPORT_SYMBOL_GPL(netdev_core_stats_inc);
 
