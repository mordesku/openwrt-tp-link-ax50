// SPDX-License-Identifier: GPL-2.0-only
#include <dt-bindings/interrupt-controller/mips-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "lantiq,grx500", "lantiq,xrx500";

	/* AX50 vendor 3.10 allocation. Disabled until explicitly selected by
	 * the experiment: GPTC0/3A source; events GPTC1/1A, GPTC0/1A,
	 * GPTC1/2A, GPTC1/3A for CPU0..3. Vendor IRQs 168/126/170/172
	 * subtract MIPS_GIC_IRQ_BASE=8 to obtain shared GIC inputs.
	 */
	gptc_system: timer@16b00000 {
		compatible = "lantiq,grx500-system-timer";
		reg = <0x16b00000 0x100>, <0x16300000 0x100>;
		reg-names = "gptc0", "gptc1";
		clock-frequency = <200000000>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SHARED 160 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SHARED 118 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SHARED 162 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SHARED 164 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "cpu0", "cpu1", "cpu2", "cpu3";
		status = "disabled";
	};

	aliases {
		serial0 = &asc0;
		serial1 = &asc1;
		pcie0   = &pcie0;
		pcie1   = &pcie1;
		pcie2   = &pcie2;
		gpio0   = &gpio0;
		gpio1   = &gpio1;
		usb0    = &usb0;
		usb1    = &usb1;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "mips,InterAptiv";
			reg = <0>;
		};
		cpu@1 {
			device_type = "cpu";
			compatible = "mips,InterAptiv";
			reg = <1>;
		};
		cpu@2 {
			device_type = "cpu";
			compatible = "mips,InterAptiv";
			reg = <2>;
		};
		cpu@3 {
			device_type = "cpu";
			compatible = "mips,InterAptiv";
			reg = <3>;
		};
	};

	cpu_intc: interrupt-controller {
		compatible = "mti,cpu-interrupt-controller";
		interrupt-controller;
		#interrupt-cells = <1>;
	};

	ssx3@18000000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "lantiq,ssx", "simple-bus";
		reg = <0x18000000 0xa8000000>;
		ranges = <0x0 0x18000000 0xa8000000>;

		pcie0: pcie@900000 {
			status = "disabled";
			compatible = "lantiq,pcie-xrx500";
			device_type = "pci";
			#address-cells = <3>;
			#size-cells = <2>;
			reg = <
				0x900000 0x100000
				0xa3000000 0x800000
				0x800000 0x100000
				0x500000 0x100000
				0x600000 0x100000
				0x700000 0x100000
			>;
			reg-names = "csr", "cfg", "app", "phy", "msi", "pic";
			interrupt-parent = <&gic>;
			/*
			 * GIC numbering note: the vendor 3.10 DT uses cells that
			 * are offset by +8 from the physical GIC shared input
			 * (vendor xrx500.dtsi pcie0: msi0-7=<136..143> ir=<160>
			 * INTA..INTD=<144..147>; vendor GIC driver operates the
			 * physical inputs msi=128..135, ir=152, legacy=136..139
			 * per its polarity table and pcie_intx_war()). Linux 6.12
			 * MIPS GIC xlate uses the DT cell as the physical input
			 * directly, so all pcie numbers below are the physical
			 * ones (vendor cell minus 8). The rest of this dtsi
			 * (gpio 172/173, gptc, asc) already uses physical
			 * numbering.
			 *
			 * PCIe legacy INTx GIC inputs are ACTIVE-HIGH level
			 * (vendor GIC driver fixed polarity table:
			 * GIC_POL_POS | GIC_TRIG_LEVEL for "pcie legacy"), the
			 * msi inputs are positive edge. The RC asserts the
			 * per-pin GIC line HIGH on Assert_INTx and latches it in
			 * PCIE_IRNCR (RC app +0xF8, W1C).
			 *
			 * The port itself is the INTx interrupt controller: the
			 * "inta".."intd" entries below are the per-pin GIC parent
			 * lines; the pcie-xrx500 driver demuxes them through its
			 * INTx irqchip, which owns the IRNEN gating and the
			 * per-event IRNCR latch clear (vendor pcie_intx_war).
			 */
			interrupt-controller;
			interrupts = <GIC_SHARED 128 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 129 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 130 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 131 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 132 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 133 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 134 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 135 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 152 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 136 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 137 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 138 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 139 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi0", "msi1", "msi2", "msi3",
					  "msi4", "msi5", "msi6", "msi7",
					  "ir", "inta", "intb", "intc", "intd";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			/* INTx pins of downstream devices map to this controller */
			interrupt-map = <0 0 0 1 &pcie0 0>,
					<0 0 0 2 &pcie0 1>,
					<0 0 0 3 &pcie0 2>,
					<0 0 0 4 &pcie0 3>;
			ranges = <0x02000000 0 0xa0000000 0xa0000000 0 0x03000000
				  0x01000000 0 0xa3800000 0xa3800000 0 0x00100000>;
			resets = <&rcu0 12>;
			reset-names = "phy";
			lantiq,inbound-shift = <5>;
			lantiq,outbound-shift = <4>;
			lantiq,clkout = <22>;
		};

		pcie1: pcie@400000 {
			status = "disabled";
			compatible = "lantiq,pcie-xrx500";
			device_type = "pci";
			#address-cells = <3>;
			#size-cells = <2>;
			reg = <
				0x400000 0x100000
				0x9f000000 0x800000
				0x300000 0x100000
				0x000000 0x100000
				0x100000 0x100000
				0x200000 0x100000
			>;
			reg-names = "csr", "cfg", "app", "phy", "msi", "pic";
			interrupt-parent = <&gic>;
			/* Physical GIC inputs (vendor DT cell minus 8, see pcie0 note);
			 * INTx demuxed by the pcie-xrx500 INTx irqchip (see pcie0 note) */
			interrupt-controller;
			interrupts = <GIC_SHARED 37 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 38 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 39 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 40 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 41 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 42 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 43 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 44 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 49 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 9 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 10 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 11 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 12 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi0", "msi1", "msi2", "msi3",
					  "msi4", "msi5", "msi6", "msi7",
					  "ir", "inta", "intb", "intc", "intd";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &pcie1 0>,
					<0 0 0 2 &pcie1 1>,
					<0 0 0 3 &pcie1 2>,
					<0 0 0 4 &pcie1 3>;
			ranges = <0x02000000 0 0x9c000000 0x9c000000 0 0x03000000
				  0x01000000 0 0x9f800000 0x9f800000 0 0x00100000>;
			resets = <&rcu0 13>;
			reset-names = "phy";
			lantiq,inbound-shift = <9>;
			lantiq,outbound-shift = <8>;
			lantiq,clkout = <23>;
		};

		pcie2: pcie@e00000 {
			status = "disabled";
			compatible = "lantiq,pcie-xrx500";
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			reg = <
				0xe00000 0x100000
				0xa7000000 0x800000
				0xd00000 0x100000
				0xa00000 0x100000
				0xb00000 0x100000
				0xc00000 0x100000
			>;
			reg-names = "csr", "cfg", "app", "phy", "msi", "pic";
			interrupt-parent = <&gic>;
			/* Physical GIC inputs (vendor DT cell minus 8, see pcie0 note);
			 * INTx demuxed by the pcie-xrx500 INTx irqchip (see pcie0 note) */
			interrupt-controller;
			interrupts = <GIC_SHARED 24 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 25 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 26 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 27 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 28 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 29 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 30 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 31 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SHARED 55 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 155 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 156 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 157 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 158 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi0", "msi1", "msi2", "msi3",
					  "msi4", "msi5", "msi6", "msi7",
					  "ir", "inta", "intb", "intc", "intd";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &pcie2 0>,
					<0 0 0 2 &pcie2 1>,
					<0 0 0 3 &pcie2 2>,
					<0 0 0 4 &pcie2 3>;
			ranges = <0x02000000 0 0xa4000000 0xa4000000 0 0x03000000
				  0x01000000 0 0xa7800000 0xa7800000 0 0x00100000>;
			resets = <&rcu0 10>;
			reset-names = "phy";
			lantiq,inbound-shift = <13>;
			lantiq,outbound-shift = <12>;
			lantiq,clkout = <24>;
		};
	};

	ssx4@16000000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "lantiq,ssx", "simple-bus";
		reg = <0x16000000 0x2000000>;
		ranges = <0x0 0x16000000 0x02000000>;

		rcu0: reset-controller@0 {
			compatible = "lantiq,rcu-grx500", "lantiq,rcu-xrx500";
			reg = <0x000000 0x80000>;
			#reset-cells = <1>;
		};

		cgu0: cgu@200000 {
			compatible = "lantiq,cgu-grx500", "lantiq,cgu-xrx500";
			reg = <0x200000 0x100000>;
		};

		ebu0: ebu@f00000 {
			compatible = "lantiq,ebu-grx500", "lantiq,ebu-xrx500";
			reg = <0xf00000 0x100000>,
			      <0x1000000 0x100000>;
			reg-names = "ebunand_reg", "hsnand_reg";
		};

		asc0: serial@600000 {
			compatible = "lantiq,asc";
			reg = <0x600000 0x100000>;
			interrupt-parent = <&gic>;
			/* Vendor Linux IRQs 111/113/114 minus MIPS_GIC_IRQ_BASE=8. */
			interrupts = <GIC_SHARED 103 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 105 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 106 IRQ_TYPE_LEVEL_HIGH>;
		};

		asc1: serial@700000 {
			compatible = "lantiq,asc";
			reg = <0x700000 0x100000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SHARED 76 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 78 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SHARED 79 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		gpio0: gpio@c00000 {
			compatible = "lantiq,gpio-xrx500", "lantiq,grx500-gpio";
			reg = <0xc00000 0x80>,
			      <0xc80000 0x100>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SHARED 172 IRQ_TYPE_LEVEL_HIGH>;
			lantiq,bank = <0>;
		};

		gpio1: gpio@c00100 {
			compatible = "lantiq,gpio-xrx500", "lantiq,grx500-gpio";
			reg = <0xc00100 0x80>,
			      <0xc80100 0x100>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SHARED 173 IRQ_TYPE_LEVEL_HIGH>;
			lantiq,bank = <1>;
		};
	};

	usb0: usb@1a300000 {
		compatible = "lantiq,grx500-dwc3";
		reg = <0x1a300000 0x100000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		status = "disabled";

		dwc3_0: dwc3@1a300000 {
			compatible = "snps,dwc3";
			reg = <0x1a300000 0x100000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SHARED 54 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dwc_usb3";
			dr_mode = "host";
			snps,dis_rxdet_inp3_quirk;
			linux,sysdev_is_parent;
		};
	};

	usb1: usb@1a500000 {
		compatible = "lantiq,grx500-dwc3";
		reg = <0x1a500000 0x100000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		status = "disabled";

		dwc3_1: dwc3@1a500000 {
			compatible = "snps,dwc3";
			reg = <0x1a500000 0x100000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SHARED 83 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dwc_usb3";
			dr_mode = "host";
			snps,dis_rxdet_inp3_quirk;
			linux,sysdev_is_parent;
		};
	};

	ssx6@12000000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "lantiq,ssx", "simple-bus";
		reg = <0x12000000 0x2000000>;
		ranges = <0x0 0x12000000 0x02000000>;

		gic: gic@320000 {
			#interrupt-cells = <3>;
			interrupt-controller;
			compatible = "lantiq,gic-grx500", "mti,gic";
			reg = <0x320000 0x20000>;
			interrupt-parent = <&cpu_intc>;
		};
	};
};
