/dts-v1/;

#include "grx500.dtsi"

/ {
	model = "TP-Link Archer AX50 v1";
	compatible = "tplink,archer-ax50-v1", "lantiq,grx500", "lantiq,xrx500";

	aliases {
		serial0 = &asc0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@20000000 {
		device_type = "memory";
		reg = <0x20000000 0x0e000000>; /* Vendor DDR base; retain conservative 224 MiB test size. */
	};
};

&asc0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&pcie2 {
	status = "okay";
};
